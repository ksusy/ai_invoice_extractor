# Příklad konfigurace prostředí
# Zkopírujte do .env a doplňte skutečné hodnoty.

APP_NAME="AI Invoice Extractor"
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoices

# API klíč. Bez něj běží pipeline v degradovaném režimu na regulárních
# výrazech — výsledky mají výrazně nižší kvalitu, viz README.
OPENAI_API_KEY=

# Cesta k Tesseractu. Prázdné = zjistí se automaticky (PATH, na Windows
# obvyklé umístění instalátoru).
TESSERACT_CMD=
